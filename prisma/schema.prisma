generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A substation/project, e.g. "2024 New Solar Substation" at the "Bandit"
// substation. substationName is the short name used at the front of every
// photo filename (matches the real OneDrive AMP convention: "Bandit - ...").
model Project {
  id              String    @id @default(cuid())
  name            String
  substationName  String
  client          String?
  date            DateTime?
  folders         Folder[]
  areas           ProjectArea[]
  createdAt       DateTime  @default(now())
}

// A per-project equipment/panel folder, e.g. "CCVTs 161kV" under Yard, or
// "Panel A7 (PD-3519)" under House. Names are free-typed by the user (or
// picked from ones already created in this project), not a fixed list.
// A folder can also contain subfolders (e.g. "Arresters" -> "Line
// Arresters" / "Bus Arresters"), via the self-relation below; top-level
// folders have parentId null.
model Folder {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  area      String   // "Yard" | "House"
  name      String
  parentId  String?
  parent    Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderChildren")
  photos    Photo[]
  createdAt DateTime @default(now())

  @@index([projectId, area])
  @@index([parentId])
}

model Photo {
  id          String   @id @default(cuid())
  folderId    String
  folder      Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  description String   // free text, e.g. "Breaker 4W108 (F1) CTs Nameplate"
  phase       String?  // "A" | "B" | "C" | null
  filename    String
  dataUrl     String
  createdAt   DateTime @default(now())

  @@index([folderId])
}

// An extra, user-named site/area within a project, beyond the default
// Yard and House (e.g. "Switchyard 2", "Control House B"). Folders are
// still just grouped by the "area" string on Folder, so these don't need
// their own relation to Folder -- deleting one also deletes any Folder
// rows (and their Photos) whose area matches this name (see
// app/api/project-areas/[id]/route.ts).
model ProjectArea {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([projectId, name])
}

// A global, reusable list of folder names per area, shown as quick-pick
// buttons when creating a folder in any project. Seeded from the real AMP
// folder names already used on OneDrive; any new custom name a tech types
// gets added here too, so it's available as a quick pick in future projects.
model FolderPreset {
  id        String   @id @default(cuid())
  area      String   // "Yard" | "House"
  name      String
  createdAt DateTime @default(now())

  @@unique([area, name])
}

// A separate account per person (username + password), same idea as
// PrimeCore Ops' Employee model but without the payroll/HR fields this app
// doesn't need. Registration now requires a one-time access code (see
// AccessCode below) generated by an admin from /admin -- not the old
// single shared REGISTER_CODE, which couldn't be revoked for just one
// person. isAdmin unlocks /admin (generating/revoking codes, activating/
// deactivating accounts) -- there's no per-tab permission matrix like
// ops.primecore's allowedTabs since this app is one single workflow, not
// several. active=false is how an admin revokes someone's access without
// deleting their account (see toggle in /api/users) -- checked fresh from
// the DB by lib/access.ts on every API call that needs it (middleware.ts
// runs on the Edge runtime and can only verify the session cookie's
// signature, not query Postgres -- see its own comments).
model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  name         String?
  isAdmin      Boolean   @default(false)
  active       Boolean   @default(true)
  passkeys     Passkey[]
  createdAccessCodes AccessCode[] @relation("AccessCodeCreatedBy")
  usedAccessCode     AccessCode?  @relation("AccessCodeUsedBy")
  createdAt    DateTime  @default(now())
}

// A one-time invite code an admin generates from /admin so a specific
// worker can create their own account at /login (the "Create one" link).
// used_at/usedById gets set the moment it's redeemed so it can never be
// reused; revoked lets the admin cancel an unused code before anyone
// redeems it. Replaces the old REGISTER_CODE env var (a single code
// shared by everyone, with no way to revoke just one person's access).
model AccessCode {
  id          String    @id @default(cuid())
  code        String    @unique
  note        String?
  createdById String
  createdBy   User      @relation("AccessCodeCreatedBy", fields: [createdById], references: [id])
  usedById    String?   @unique
  usedBy      User?     @relation("AccessCodeUsedBy", fields: [usedById], references: [id])
  usedAt      DateTime?
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

// A registered Face ID / Touch ID / Windows Hello credential (WebAuthn
// passkey), belonging to one User. Always added from inside an already
// logged-in session (via password), never used to "claim" the app the way
// it briefly did before per-user accounts existed.
model Passkey {
  id         String   @id // credential ID, base64url -- generated by the device, not us
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey  String // base64url-encoded COSE public key
  counter    Int      @default(0)
  deviceType String?
  backedUp   Boolean  @default(false)
  transports String? // comma-separated, e.g. "internal"
  label      String? // e.g. "Rasiel's iPhone"
  createdAt  DateTime @default(now())

  @@index([userId])
}
